# Copier en .env (non versionné) avant docker compose up
POSTGRES_PASSWORD=postgres
# mot de passe des utilisateurs <service>_user
DB_PASSWORD=store
# au moins 32 caractères, identique pour tous les services
JWT_SECRET=change-me-change-me-change-me-change-me
# secret service → service exigé sur /internal/** (32 caractères min., différent de JWT_SECRET)
INTERNAL_SECRET=change-me-internal-change-me-internal-00
# port hôte de la gateway (8080 souvent pris par Apache/XAMPP)
GATEWAY_PORT=8080
